{
  "expo": {
    "name": "lab-btp-mobile",
    "slug": "lab-btp-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "labbtpmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.appsdev.labbtp"
    },
    "android": {
      "package": "fr.appsdev.labbtp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-image-picker", {
        "cameraPermission": "Autoriser l'appareil photo pour joindre des images aux formulaires de tâche.",
        "photosPermission": "Autoriser l'accès aux photos pour les joindre aux formulaires de tâche."
      }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
